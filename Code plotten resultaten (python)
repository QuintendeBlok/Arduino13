import numpy as np
import matplotlib.pyplot as plt

# Load the combined CSV data, skipping the header string
# Columns: Time (s) [0], CO2 (ppm) [1], T (C) [2], P (Pa) [3], RH (%) [4]
data = np.genfromtxt("data.csv", delimiter=",", skip_header=1)

time = data[:, 0]
co2 = data[:, 1]
temp = data[:, 2]
humidity = data[:, 4]

# Create a figure with 3 subplots sharing the X (time) axis
fig, (ax1, ax2, ax3) = plt.subplots(3, 1, sharex=True, figsize=(10, 8))

# Plot CO2
ax1.plot(time, co2, color='tab:blue', marker='o', markersize=4)
ax1.set_ylabel("CO2 (ppm)")
ax1.grid(True, linestyle='--', alpha=0.6)

# Plot Temperature
ax2.plot(time, temp, color='tab:red')
ax2.set_ylabel("Temperature (°C)")
ax2.grid(True, linestyle='--', alpha=0.6)

# Plot Humidity
ax3.plot(time, humidity, color='tab:green')
ax3.set_ylabel("Relative Humidity (%)")
ax3.set_xlabel("Time (seconds)")
ax3.grid(True, linestyle='--', alpha=0.6)

plt.suptitle("Environmental Sensor Data")
plt.tight_layout()
plt.show()
