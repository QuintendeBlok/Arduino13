#include <SPI.h>
#include <SD.h>
#include <SoftwareSerial.h>
#include <Adafruit_BME280.h>

// Sensor and SD configuration
const int chipSelect = 10;
#define MH_Z19_RX 6
#define MH_Z19_TX 7
const int statusLed = 13;
const int time_step = 10000; // 10-second measurement intervals

// --- NEW TIME LIMIT VARIABLES ---
// Set your desired experiment duration in milliseconds (e.g., 5 mins = 300,000 ms)
const unsigned long experimentDuration = 300000; 
unsigned long startTime;
bool experimentRunning = true;
// --------------------------------

SoftwareSerial co2Serial(MH_Z19_RX, MH_Z19_TX);
byte cmd[] = {0xFF, 0x01, 0x86, 0x00, 0x00, 0x00, 0x00, 0x00, 0x79};
unsigned char response[9];

Adafruit_BME280 bme;
float lastT, lastP, lastH;
File myFile;
unsigned long lastLogTime = 0;
int lineCounter = 1;

void setup() {
  Serial.begin(9600);
  pinMode(statusLed, OUTPUT);

  if (!SD.begin(chipSelect)) {
    Serial.println("SD FAILED!");
    while (1);
  }

  if (!SD.exists("data.csv")) {
    myFile = SD.open("data.csv", FILE_WRITE);
    if (myFile) {
      myFile.println("Time (s), CO2 (ppm), T (C), P (Pa), RH (%)");
      myFile.close();
    }
  }

  if (!bme.begin(0x76)) {
    Serial.println("BME280 FAILED!");
    while (1);
  }

  co2Serial.begin(9600);
  
  // Record the exact time the experiment starts
  startTime = millis(); 
  Serial.println("System Ready. Experiment started!");
}

void loop() {
  // 1. Check if the experiment is still allowed to run
  if (experimentRunning) {
    
    // 2. Check if the total time has exceeded the predetermined duration
    if (millis() - startTime >= experimentDuration) {
      experimentRunning = false; // Disable further measurements
      Serial.println("Experiment complete! The time limit has been reached.");
      Serial.println("It is now safe to disconnect the power.");
      return; // Skip the rest of this loop iteration
    }

    // 3. Normal sensor reading and logging routine (every 10 seconds)
    if (millis() - lastLogTime >= time_step) {
      lastLogTime = millis();
      digitalWrite(statusLed, HIGH);

      lastT = bme.readTemperature();
      lastP = bme.readPressure();
      lastH = bme.readHumidity();

      while(co2Serial.available()) { co2Serial.read(); }
      co2Serial.write(cmd, 9);
      delay(150);
      
      int availableBytes = co2Serial.available();
      if (availableBytes >= 9) {
        for (int i = 0; i < 9; i++) {
          response[i] = co2Serial.read();
        }
        
        if (response[0] == 0xFF && response[1] == 0x86) {
          int co2ppm = (response[2] << 8) + response[3];
          int secondsPassed = lineCounter * (time_step / 1000);

          Serial.print("CO2_ppm:"); Serial.print(co2ppm); Serial.print(",");
          Serial.print("Temp_C:"); Serial.print(lastT); Serial.print(",");
          Serial.print("Humidity_%:"); Serial.println(lastH);

          myFile = SD.open("data.csv", FILE_WRITE);
          if (myFile) {
            myFile.print(secondsPassed); myFile.print(",");
            myFile.print(co2ppm); myFile.print(",");
            myFile.print(lastT); myFile.print(",");
            myFile.print(lastP); myFile.print(",");
            myFile.println(lastH);
            myFile.close();
            lineCounter++;
          }
        }
      }
      digitalWrite(statusLed, LOW);
    }
  }
}
